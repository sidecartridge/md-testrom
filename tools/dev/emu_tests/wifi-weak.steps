# A weak signal: Wi-Fi works, with a warning; the names kept in the report.
@rssi -75
@debug
say "^Press a key" 100
key x
key o
say "^WARN  Gate overridden" 100
sayn 2 "^Press a key" 300
key w
say "^Starting the radio chip" 100
say "^  Booster's network EmuMD, -75 dBm \(very weak\)" 3000
say "^PASS  Wi-Fi works, out to the internet" 100
say "^WARN  The signal is weak" 100
say "^  -75 dBm" 100
sayn 3 "^Press a key" 300
key s
say "^Keep the Wi-Fi and Bluetooth names heard in the report" 100
key y
say "^  names kept" 100
say "^Report saved on the microSD card as MDTEST-REPORT-00.TXT" 1500
sdfile MDTEST-REPORT-00.TXT "^  Booster's network EmuMD, -75 dBm \(very weak\)\r$"
