# A write-protected floppy: the report is not saved, the program says so and
# carries on.
@protect on
say "^Press a key" 100
key s
say "^WARN  The report could not be saved" 1000
say "^  REPORT00.TXT: GEMDOS error -\d+" 100
say "^Check the disk is not write-protected or full" 100
key q
wait 100
nofloppy REPORT00.TXT
