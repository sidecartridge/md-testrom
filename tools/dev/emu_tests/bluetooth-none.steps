# Bluetooth with nothing around: a pass, with the warning and advice.
@btnone
@debug
say "^Press a key" 100
key x
key o
say "^WARN  Gate overridden" 100
sayn 2 "^Press a key" 300
key t
say "^Starting the Bluetooth controller" 100
say "^  Devices   0 heard: 0 classic, 0 low energy" 2000
say "^PASS  Bluetooth works" 100
say "^WARN  No Bluetooth device was heard" 100
say "^Make a phone nearby visible" 100
